require "fileutils"
require "opal"
require "opal/builder"

ROOT = File.expand_path(__dir__)
LIB = File.join(ROOT, "lib")
DIST = File.join(ROOT, "dist")
STATIC_EXAMPLE = File.join(ROOT, "examples", "static")
GIRAFFIC_EXAMPLE = File.join(ROOT, "examples", "giraffic")
SPEC = File.join(ROOT, "spec")
INTEGRATION_SPEC = File.join(SPEC, "integration")
SPEC_DIST = File.join(INTEGRATION_SPEC, "dist")

def build_framework
  # The runtime (opal/mini) is pulled in by swill.rb itself, so building
  # "swill" yields the whole bundle — core plus framework.
  builder = Opal::Builder.new
  builder.append_paths(LIB)
  builder.build("swill")
  File.write(File.join(DIST, "swill.js"), builder.to_s)
end

def build_example(directory, source_name)
  source = File.read(File.join(directory, "app.rb"))
  javascript = Opal.compile(source, file: source_name)
  File.write(File.join(directory, "dist", "app.js"), javascript)
end

def build_integration
  # The integration app requires "swill", which pulls the runtime in turn.
  builder = Opal::Builder.new
  builder.append_paths(LIB)
  builder.append_paths(INTEGRATION_SPEC)
  builder.build("app")
  File.write(File.join(SPEC_DIST, "integration.js"), builder.to_s)
end

desc "Compile Swill and the examples"
task :build do
  FileUtils.mkdir_p(DIST)
  FileUtils.mkdir_p(File.join(STATIC_EXAMPLE, "dist"))
  FileUtils.mkdir_p(File.join(GIRAFFIC_EXAMPLE, "dist"))
  build_framework
  build_example(STATIC_EXAMPLE, "examples/static/app.rb")
  build_example(GIRAFFIC_EXAMPLE, "examples/giraffic/app.rb")
end

desc "Run the pure-Ruby MRI specs"
task :spec do
  Dir[File.join(SPEC, "**", "*_spec.rb")].sort.each do |file|
    ruby file or raise "spec failed: #{file}"
  end
end

desc "Build and run the Opal + DOM-shim integration check under Node"
task :integration do
  FileUtils.mkdir_p(SPEC_DIST)
  build_integration
  sh "node", File.join(INTEGRATION_SPEC, "integration.js")
end

desc "Run all checks: MRI specs and the Node integration"
task test: %i[spec integration]

task default: :build
