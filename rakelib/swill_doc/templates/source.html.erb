    <header class="page-header">
      <h1><span class="kind">File</span><span class="title"><%= h File.basename(path_text) %></span></h1>
      <div class="source"><%= h path_text %></div>
    </header>
    <div class="content">
      <article class="body">
<%- unless defined.empty? -%>
        <div class="relations">
          <div class="relation">
            <h2 class="label">Defines</h2>
<%- defined.each do |link| -%>
            <%= link %>
<%- end -%>
          </div>
        </div>
        <h2 class="section-title">Source</h2>
<%- end -%>
        <pre class="source-listing <%= language %>"><%- lines.each.with_index(1) do |line, number| -%><span class="source-line" id="line-<%= number %>"><span class="line-number"><%= number %></span><%= line %></span>
<%- end -%></pre>
      </article>
    </div>
