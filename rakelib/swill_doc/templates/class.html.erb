<%-
  includes = klass.includes
  derived = klass.module? ? [] : subclasses(klass)
  constants = klass.constants.sort_by(&:name)
  relations = [
    ["Includes", includes.map { |included| class_link(included.module, short: true) }],
    ["Included in", klass.module? ? includers(klass).map { |includer| spelled(class_link(includer), javascript_class_link(includer)) } : []],
    ["Derivatives", derived.map { |subclass| spelled(class_link(subclass), javascript_class_link(subclass)) }]
  ].reject { |_, links| links.empty? }
-%>
    <header class="page-header">
<%- javascript_name = public_javascript_name(klass.full_name) -%>
<%- compiled = compiled?(klass) -%>
      <h1><span class="kind"><%= klass.module? ? "Module" : "Class" %></span><span class="title"><%= spelled(h(klass.full_name), h(javascript_name || klass.full_name)) %></span></h1>
<%- klass.in_files.each do |file| -%>
      <a class="source" href="<%= h href_to(file) %>"><%= h file.relative_name %></a>
<%- end -%>
<%- unless klass.module? -%>
      <div class="superclass"><span class="label">Superclass: </span><%= spelled(class_link(superclass_of(klass), short: true), javascript_class_link(superclass_of(klass))) %></div>
<%- end -%>
<%- if compiled && !javascript_name -%>
      <div class="language-note lang-javascript">Not reachable by a public name from plain JavaScript.</div>
<%- elsif !compiled -%>
      <div class="language-note lang-javascript">Not compiled to JavaScript: this runs only in Ruby.</div>
<%- end -%>
    </header>
    <div class="content">
      <article class="body">
<%- unless klass.description.strip.empty? -%>
        <div class="description"><%= klass.description %></div>
<%- end -%>
<%- unless relations.empty? -%>
        <hr class="divider">
        <div class="relations">
<%- relations.each do |title, links| -%>
          <div class="relation">
            <h2 class="label"><%= title %></h2>
<%- links.each do |link| -%>
            <%= link %>
<%- end -%>
          </div>
<%- end -%>
<%- if relations.size == 1 -%>
          <div class="relation"></div>
<%- end -%>
        </div>
<%- end -%>
<%- unless constants.empty? -%>
        <h2 class="section-title">Constants</h2>
<%- constants.each_with_index do |constant, index| -%>
<%- if index.positive? -%>
        <hr class="row-divider">
<%- end -%>
        <div class="constant" id="<%= h constant.name %>">
          <span class="constant-name"><%= h constant.name %></span>
          <pre class="constant-value"><%= h constant_value(constant) %></pre>
<%- unless constant.description.strip.empty? -%>
          <div class="constant-comment"><%= constant.description %></div>
<%- end -%>
        </div>
<%- end -%>
<%- end -%>
<%- sections = member_sections(klass) -%>
<%- sections.each do |section, groups| -%>
<%- heading = section.title ? "h3" : "h2" -%>
<%- if section.title -%>
        <section class="topic" id="<%= h section.aref %>">
          <h2 class="topic-title"><%= h section.title %></h2>
<%- unless section.description.strip.empty? -%>
          <div class="topic-description"><%= section.description %></div>
<%- end -%>
<%- end -%>
<%- groups.each do |title, kind, list| -%>
        <<%= heading %> class="section-title"><%= title %></<%= heading %>>
<%- case kind -%>
<%- when :declaration -%>
<%- list.each do |declaration| -%>
        <div class="property" id="<%= h declaration.aref %>">
          <div class="property-signature"><span class="property-name"><%= member_prefix(declaration) %><%= spelled(h(declaration.name), h(javascript_property(klass, declaration.name))) %></span><span class="property-meta"><%= spelled(type_html(declaration.declared_type, klass), ts_type_html(declaration.declared_type, klass) + (declaration.rw == "R" ? " (read-only)" : "")) %></span></div>
<%- unless declaration.description.strip.empty? -%>
          <div class="property-description"><%= declaration.description %></div>
<%- end -%>
        </div>
<%- end -%>
<%- when :attribute -%>
        <div class="attributes">
<%- list.each do |attribute| -%>
          <div class="property" id="<%= h attribute.aref %>">
            <div class="property-signature"><span class="property-name"><%= member_prefix(attribute) %><%= spelled(h(attribute.name), compiled ? h(javascript_member(attribute.name)) : nil) %></span><span class="property-meta"><%= spelled(attribute_meta(attribute), attribute.rw == "R" ? "getter" : attribute_meta(attribute)) %></span></div>
<%- unless attribute.description.strip.empty? -%>
            <div class="property-description"><%= attribute.description %></div>
<%- end -%>
          </div>
<%- end -%>
        </div>
<%- else -%>
<%- list.each do |method| -%>
        <section class="method <%= kind %>" id="<%= h method.aref %>">
<%- javascript = macro?(klass, method) ? [] : javascript_signatures(klass, method) -%>
          <h3 class="method-header"><%= spelled(signature_html(method), javascript.empty? ? nil : javascript.join("<br>")) %></h3>
<%- if macro?(klass, method) -%>
          <div class="method-body language-note lang-javascript">A declaration in Ruby. Plain JavaScript declares with static fields instead; see <a href="<%= h link_to_path('doc/plain_javascript_md.html') %>">Plain JavaScript</a>.</div>
<%- end -%>
<%- unless method.description.strip.empty? -%>
          <div class="method-body"><%= method.description %></div>
<%- end -%>
        </section>
<%- end -%>
<%- end -%>
<%- end -%>
<%- if section.title -%>
        </section>
<%- end -%>
<%- end -%>
<%- included_modules(klass).each do |mod| -%>
<%- members = included_members(mod) -%>
<%- next if members.empty? -%>
        <h2 class="section-title">Included from <%= class_link(mod, short: true) %></h2>
        <dl class="included-members">
<%- members.each do |title, list| -%>
          <dt><%= title %></dt>
          <dd><%= list.map { |member| member_link(mod, member) }.join(", ") %></dd>
<%- end -%>
        </dl>
<%- end -%>
      </article>
<%- index = page_index(sections) -%>
<%- unless index.empty? -%>
      <aside class="page-index">
<%- index.each do |title, aref, list| -%>
        <header class="pane-header"><%= aref ? %(<a href="##{h aref}">#{h title}</a>) : h(title) %></header>
        <ul class="index">
<%- list.each do |entry| -%>
          <li><a href="#<%= h entry.aref %>"><%= index_entry_html(klass, entry) %></a></li>
<%- end -%>
        </ul>
<%- end -%>
      </aside>
<%- end -%>
    </div>
